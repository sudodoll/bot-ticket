# ─────────────────────────────────────────────────────────────
#  Bot de Tickets · Variables de entorno
#  Copiá este archivo como ".env" y completá los valores.
#  NUNCA compartas ni subas el archivo .env (contiene el token).
# ─────────────────────────────────────────────────────────────

# Token del bot.
# Developer Portal → tu aplicación → Bot → "Reset Token" → copiar.
DISCORD_TOKEN=

# ID de la aplicación (Application ID).
# Developer Portal → tu aplicación → General Information → "Application ID".
CLIENT_ID=

# ID del servidor (Guild ID).
# Discord (con Modo desarrollador activo) → clic derecho en el servidor → "Copiar ID del servidor".
GUILD_ID=

# ID del canal donde se publica el panel (por ejemplo #tickets-de-ayuda).
# Clic derecho en el canal → "Copiar ID del canal".
TICKET_CHANNEL_ID=

# ID de la categoría donde se crean los canales de cada ticket.
# Clic derecho en el nombre de la categoría → "Copiar ID de la categoría".
TICKETS_CATEGORY_ID=

# ID del rol "Atención al Cliente".
# Ajustes del servidor → Roles → clic derecho en el rol → "Copiar ID del rol".
CUSTOMER_SUPPORT_ROLE_ID=

# ─────────────── Opcionales (tienen valores por defecto) ───────────────

# true  = prioriza agentes conectados (requiere activar "Presence Intent" en el Developer Portal).
# false = no usa presencia: cualquier miembro del rol puede recibir tickets.
ENABLE_PRESENCE_INTENT=true

# Máximo de tickets abiertos simultáneos por agente. 0 = sin límite.
# Si todos los agentes llegan al límite, los tickets nuevos quedan en espera.
MAX_TICKETS_PER_AGENT=0

# Segundos que espera el bot antes de eliminar el canal de un ticket cerrado (1 a 60).
TICKET_CLOSE_DELAY_SECONDS=5

# Ruta del archivo SQLite (relativa a la carpeta del proyecto o absoluta).
DATABASE_PATH=./data/tickets.sqlite
